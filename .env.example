# Base URL of your deployed backend proxy (see README.md's "Backend
# proxy" section and functions/index.js). The Android app calls Gemini
# and Groq through this Cloud Functions proxy instead of holding their
# API keys itself, so it needs to know where the proxy lives.
#
# Format: https://us-central1-<your-firebase-project-id>.cloudfunctions.net/
# (region is us-central1 unless you changed the `region` option in
# functions/index.js). Trailing slash matters.
BACKEND_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net/

# NOTE: GEMINI_API_KEY and GROQ_API_KEY used to live here and get baked
# into the app at build time. They no longer do -- shipping an API key
# inside a compiled APK means anyone who installs the app can extract it
# (APKs are trivially decompilable). Both keys now live exclusively as
# Firebase Functions secrets on the backend:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set GROQ_API_KEY
# See README.md for the full deploy walkthrough.
