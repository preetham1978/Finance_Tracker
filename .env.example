# Gemini API Key for financial insights, bill analysis and tax planning
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (free at console.groq.com/keys). Used as a
# fallback text-generation provider for Spend Insights and Tax Planning
# when Gemini itself fails (e.g. depleted prepay billing credits). Not
# required -- the app falls back further to offline templates if this is
# also unset.
GROQ_API_KEY=your_groq_api_key_here
